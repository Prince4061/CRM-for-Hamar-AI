    {
      "parameters": {
        "name": "Notify_Owner",
        "description": "Save_Lead tool chalane ke TURANT BAAD is tool ko call karo. Ye shop owner ke WhatsApp par ek lead alert bhejta hai. Parameters: {\"mobile\": \"customer mobile\", \"name\": \"customer name\", \"query_type\": \"Plot/Flat\", \"location\": \"location\", \"budget\": \"budget\", \"lead_score\": \"Hot/Warm/Cold\", \"chat_summary\": \"summary\", \"inst\": \"prince\"}",
        "jsCode": "let data;\ntry {\n  data = typeof query !== 'undefined' ? (typeof query === 'string' ? JSON.parse(query) : query) : $input.all()[0].json;\n} catch(e) {\n  data = $input.all()[0].json;\n}\nif (data && data.input && typeof data.input === 'string') {\n  try { const inner = JSON.parse(data.input); Object.assign(data, inner); } catch(ex) {}\n}\nconst evo = 'http://72.60.211.205:8080';\nconst key = 'CHANGE_THIS_TO_A_STRONG_PASSWORD';\nconst inst = data.inst || 'prince';\nconst ownerNumber = '6263210328';\nconst timestamp = new Date().toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' });\nconst emoji = data.lead_score === 'Hot' ? '🔥' : data.lead_score === 'Warm' ? '⚡' : '❄️';\nconst msg = emoji + ' NEW LEAD - Hamar Properties!\\n\\n📱 Mobile: +' + (data.mobile || 'Unknown') + '\\n👤 Name: ' + (data.name || 'Unknown') + '\\n🏠 Type: ' + (data.query_type || 'N/A') + '\\n📍 Location: ' + (data.location || 'N/A') + '\\n💰 Budget: ' + (data.budget || 'N/A') + '\\n📊 Score: ' + (data.lead_score || 'Cold') + '\\n\\n📝 Summary:\\n' + (data.chat_summary || 'N/A') + '\\n\\n⏰ Time: ' + timestamp + '\\n\\n✅ Please follow up with the customer!';\ntry {\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: evo + '/message/sendText/' + inst,\n    headers: { apikey: key, 'Content-Type': 'application/json' },\n    body: JSON.stringify({ number: ownerNumber, text: msg })\n  });\n  return 'Owner ko WhatsApp alert bhej diya gaya!';\n} catch(e) {\n  return 'Owner notify karne mein error: ' + e.message;\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        1808,
        496
      ],
      "name": "Notify_Owner",
      "id": "f7bce670-0038-4c46-9638-f6e6da101648"
