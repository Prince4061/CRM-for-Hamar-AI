    {
      "parameters": {
        "name": "Send_Property_Image",
        "description": "Property ki image aur details directly user ke WhatsApp par bhejta hai. Parameters: {\"imageUrl\": \"https://...\", \"caption\": \"Property details text\", \"phone\": \"91XXXXXXXXXX\", \"inst\": \"prince\"}",
        "jsCode": "// 1. Input data read karne ka setup\nlet data = {};\ntry {\n  if (typeof query !== 'undefined') {\n    data = typeof query === 'string' ? JSON.parse(query) : query;\n  } else if ($input.all() && $input.all().length > 0) {\n    data = $input.all()[0].json;\n  }\n} catch(e) {\n  data = $input.all()[0].json || {};\n}\n\nif (data.input) {\n  try {\n    const inner = typeof data.input === 'string' ? JSON.parse(data.input) : data.input;\n    Object.assign(data, inner);\n  } catch(ex) {}\n}\n\n// 2. Phone Number Extraction & Smart Cleaning\nlet phone = data.phone || data.number;\n\nif (phone) {\n  phone = phone.toString().replace('@s.whatsapp.net', '').replace('+', '').trim();\n  \n  // LOGIC: Agar galti se double 91 lag gaya ho (jaise 91916263...), toh ek 91 hata dein\n  if (phone.startsWith('9191') && phone.length > 12) {\n    phone = phone.substring(2);\n  }\n}\n\n// 3. Configurations\nconst evo = 'http://72.60.211.205:8080';\nconst key = 'CHANGE_THIS_TO_A_STRONG_PASSWORD'; // <-- Apna Evolution API ka sahi password check kar lena\nconst inst = 'qsai'; \nconst imageUrl = data.imageUrl || data.image_url || data.Image || data.Photo;\n\n// 4. Validations\nif (!imageUrl || !imageUrl.startsWith('http')) {\n  return \"Error: Google Sheet se property ki photo ka valid link nahi mila.\";\n}\n\nif (!phone) {\n  return \"Error: Customer ka WhatsApp number nahi mil paya.\";\n}\n\n// 5. API Request\ntry {\n  await this.helpers.httpRequest({\n    method: 'POST',\n    url: `${evo}/message/sendMedia/${inst}`,\n    headers: { \n      'apikey': key, \n      'Content-Type': 'application/json' \n    },\n    timeout: 7000,\n    body: JSON.stringify({\n      number: phone,\n      mediatype: 'image',\n      mimetype: 'image/jpeg',\n      media: imageUrl,\n      caption: data.caption || 'Hamar Properties'\n    })\n  });\n  \n  return \"Success: Property ki image successfully WhatsApp par bhej di gayi hai!\";\n} catch(e) {\n  return \"API Error: Image nahi bheji ja saki. Wajah: \" + e.message;\n}",
        "specifyInputSchema": true,
        "jsonSchemaExample": "{\n  \"imageUrl\": \"https://example.com/image.jpg\",\n  \"caption\": \"Property details\",\n  \"phone\": \"916263210328\",\n  \"inst\": \"qsai\"\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1,
      "position": [
        1376,
        480
      ],
      "name": "Send_Property_Image",
      "id": "4205fbe0-ffad-4bbd-947b-f7708cf74852"
